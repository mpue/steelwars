def drum(kit, bpm, part, drop):
    if drop:
        return f"{RCD}/Drop/DrumLoop_{kit} {bpm} {part} Drop.wav"
    if kit == 2:
        return f"{RCD}/Breakdown/DrumLoop_2 100 Full Breakdown 100.wav" if part == "Full" else \
            f"{RCD}/Breakdown/DrumLoop_2 {part} Breakdown 100.wav"
    return f"{RCD}/Breakdown/DrumLoop_{kit} {part} Breakdown {bpm}.wav"


def bass(n, bpm, drop):
    if drop:
        return f"{RCB}/Drop/{n:02d} Bass {bpm} Drop Fm.wav"
    word = "Beakdown" if n in (1, 7) else "Breakdown"
    return f"{RCB}/Breakdown/{n:02d} Bass {word} {bpm} Fm.wav"


def mel(n, kind, bpm, drop):
    return f"{RCM}/{'Drop' if drop else 'Breakdown'}/{n:02d} {kind} {'Drop' if drop else 'Breakdown'} {bpm} Fm.wav"


def stretch(x, factor):
    """Tempo change without pitch change (ffmpeg atempo); factor > 1 = faster."""
    return ffx(x, f"atempo={factor:.6f}")


class Song:
    def __init__(self, bpm, bars):
        self.bpm = bpm
        self.bar = 240.0 / bpm
        self.n = int(round(bars * self.bar * SR))
        self.out = np.zeros((self.n, 2))
        self.used = []

    def loop(self, rel, b0, b1, gain=0.0, fin=0.01, fout=0.02, tail=0.0):
        """Tile a loop from bar b0 to bar b1 (song-relative phase); optional release tail."""
        x = load(rel, stereo=True)
        L = len(x)
        i0, i1 = int(round(b0 * self.bar * SR)), min(self.n, int(round(b1 * self.bar * SR + tail * SR)))
        idx = np.arange(i0, i1) % L
        seg = fades(x[idx], fin, fout + tail)
        self.out[i0:i1] += seg * db(gain)
        self.used.append(rel)

    def hit(self, rel, at_bar, gain=0.0, align="start", rate=1.0, tempo=None):
        x = load(rel, rate, stereo=True)
        if tempo:
            x = stretch(x, self.bpm / tempo)
        x = tailtrim(x, -70)
        t = at_bar * self.bar
        if align == "peak":
            t -= np.argmax(np.abs(x).max(axis=1)) / SR
        elif align == "end":
            t -= len(x) / SR
        i0 = int(round(t * SR))
        if i0 < 0:
            x, i0 = x[-i0:], 0
        x = x[: self.n - i0]
        self.out[i0:i0 + len(x)] += fades(x, 0.003, 0.05) * db(gain)
        self.used.append(rel)

    def master(self, name, fade_in=1.5, fade_out=6.0):
        y = fades(self.out, fade_in, fade_out)
        y = y / (peak(y) + 1e-9) * 0.7
        tmp = Path(tempfile.gettempdir()) / f"sw_premaster_{name}.f32"
        tmp.write_bytes(y.astype(np.float32).tobytes())
        base = [FFMPEG, "-v", "info", "-f", "f32le", "-ar", str(SR), "-ac", "2", "-i", str(tmp)]
        glue = "highpass=f=28,acompressor=threshold=-16dB:ratio=2.2:attack=25:release=300:makeup=1.5"
        r = _run(base + ["-af", glue + ",loudnorm=I=-14:TP=-1.0:LRA=11:print_format=json", "-f", "null", "-"])
        err = r.stderr.decode(errors="replace")
        m = json.loads(err[err.rindex("{"): err.rindex("}") + 1])
        ln = (f"loudnorm=I=-14:TP=-1.0:LRA=11:measured_I={m['input_i']}:measured_TP={m['input_tp']}:"
              f"measured_LRA={m['input_lra']}:measured_thresh={m['input_thresh']}:offset={m['target_offset']}:linear=true")
        out = MUSIC / f"{name}.{MUSIC_EXT}"
        MUSIC.mkdir(parents=True, exist_ok=True)
        codec = {"wav": ["-c:a", "pcm_s16le"], "ogg": ["-c:a", "libvorbis", "-q:a", "6"],
                 "mp3": ["-c:a", "libmp3lame", "-b:a", "224k"]}[MUSIC_EXT]
        _run(base + ["-af", glue + "," + ln + ",alimiter=limit=0.89:level=false", "-ar", str(SR)] + codec
             + ["-y", str(out)])
        tmp.unlink()
        # measure the result
        r = _run([FFMPEG, "-v", "info", "-i", str(out), "-af", "ebur128=peak=true", "-f", "null", "-"])
        e = r.stderr.decode(errors="replace")
        summ = e[e.rindex("Summary:"):]
        I = float(summ.split("I:")[1].split("LUFS")[0])
        tp = float(summ.split("Peak:")[1].split("dBFS")[0])
        dur = self.n / SR
        uniq = sorted(set(self.used))
        REPORT.append((out.name, dur, tp, I, 0, " + ".join(Path(u).name for u in uniq)))
        print(f"  {out.name:16s} {int(dur // 60)}:{dur % 60:04.1f}  {I:5.1f} LUFS  true peak {tp:5.1f} dBFS  "
              f"({len(uniq)} source files)")
        for u in uniq:
            print("      ", u)


