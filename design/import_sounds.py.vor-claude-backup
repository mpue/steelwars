def polish(x, radio):
    """Light touch for real voice takes: the recording already sounds right, so only tidy it.
    radio=True gives the unit lines a mild field-radio band (no ring mod, no crush)."""
    x = trim(x, -45)
    x = norm(x, -3)
    if radio:
        x = ffx(x, "highpass=f=280,highpass=f=280,lowpass=f=4200,lowpass=f=4200,"
                   "equalizer=f=1800:t=q:w=1.0:g=3")
        x = np.tanh(x * 1.6) / np.tanh(1.6)
    else:
        x = ffx(x, "highpass=f=90,equalizer=f=3000:t=q:w=1.2:g=1.5")
    x = ffx(x, "acompressor=threshold=-14dB:ratio=2:attack=10:release=200:makeup=1")
    return x


