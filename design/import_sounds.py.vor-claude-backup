TTS_PS1 = r"""
param([string]$Jobs)
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
Add-Type -AssemblyName System.Runtime.WindowsRuntime
$null = [Windows.Media.SpeechSynthesis.SpeechSynthesizer, Windows.Media.SpeechSynthesis, ContentType = WindowsRuntime]
$null = [Windows.Storage.Streams.DataReader, Windows.Storage.Streams, ContentType = WindowsRuntime]
$asTask = [System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object {
  $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' } | Select-Object -First 1
function Await($op, [Type]$t) { $task = $asTask.MakeGenericMethod($t).Invoke($null, @($op)); $task.Wait(); $task.Result }
$all = [Windows.Media.SpeechSynthesis.SpeechSynthesizer]::AllVoices
foreach ($j in (Get-Content -Raw -Encoding UTF8 $Jobs | ConvertFrom-Json)) {
  $s = New-Object Windows.Media.SpeechSynthesis.SpeechSynthesizer
  $v = $all | Where-Object { $_.DisplayName -like ('*' + $j.voice + '*') } | Select-Object -First 1
  if (-not $v) { $v = $all | Where-Object { $_.Language -like 'de*' } | Select-Object -First 1 }
  if ($v) { $s.Voice = $v }
  $s.Options.SpeakingRate = [double]$j.rate
  $s.Options.AudioPitch = [double]$j.pitch
  $st = Await ($s.SynthesizeTextToStreamAsync($j.text)) ([Windows.Media.SpeechSynthesis.SpeechSynthesisStream])
  $size = [uint32]$st.Size
  $r = New-Object Windows.Storage.Streams.DataReader($st.GetInputStreamAt(0))
  $null = Await ($r.LoadAsync($size)) ([uint32])
  $b = New-Object byte[] $size
  $r.ReadBytes($b)
  [System.IO.File]::WriteAllBytes($j.out, $b)
  Write-Output ($j.out + ' <- ' + $v.DisplayName)
}
"""


def tts(jobs, tmp):
    ps1 = Path(tmp) / "tts.ps1"
    ps1.write_text(TTS_PS1, encoding="utf-8-sig")
    jf = Path(tmp) / "jobs.json"
    jf.write_text(json.dumps(jobs, ensure_ascii=False), encoding="utf-8")
    r = _run(["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(ps1), "-Jobs", str(jf)])
    return r.stdout.decode("utf-8", errors="replace")


def robot(x, ring_hz, ring_mix, crush_bits, crush_mix, down, drive):
    """Cold machine voice, intelligibility first: band-limit, ring modulation blended in,
    a short metallic comb, a little bit-crush, gentle saturation and compression."""
    x = trim(x, -45)
    x = norm(x, -3)
    x = ffx(x, "highpass=f=200,highpass=f=200,lowpass=f=5000,lowpass=f=5000")
    t = np.arange(len(x)) / SR
    x = (1 - ring_mix) * x + ring_mix * x * np.sin(2 * np.pi * ring_hz * t) * 1.6
    x = np.concatenate([x, np.zeros(int(0.12 * SR))])
    x = ffx(x, "aecho=1.0:0.75:7|13:0.32|0.2")                                   # metallic comb
    x = ffx(x, f"acrusher=level_in=1:level_out=1:bits={crush_bits}:mix={crush_mix}:mode=lin:aa=1:samples={down}")
    if drive > 0:
        x = np.tanh(x * (1 + drive)) / np.tanh(1 + drive)
    x = ffx(x, "equalizer=f=2600:t=q:w=1.2:g=3,highpass=f=170,lowpass=f=6500")    # presence for words
    # only gentle compression: a hard, fast compressor cost the most intelligibility in the
    # speech-recognition test (the robot effects themselves cost little)
    x = ffx(x, "acompressor=threshold=-12dB:ratio=2:attack=15:release=250:makeup=1")
    return x


# ElevenLabs takes (design/voice_el/<name>.mp3, eleven_multilingual_v2): announcer "Lola -
