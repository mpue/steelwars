    """sw_menu -- slow and brooding, 100 BPM felt in half time: strings, pad, sonar, big drums."""
    s = Song(100, 64)
    ST, P7 = mel(3, "Strings", 100, False), mel(7, "Pad", 100, False)
    s.loop(ST, 0, 64, -2, fin=6.0)
    s.loop(P7, 16, 56, -4, fin=4.0)
    s.loop(bass(2, 100, False), 16, 56, -2, fin=2.0)
    s.loop(mel(4, "Sonar", 100, True), 32, 56, -6, fin=0.5)
    s.loop(drum(2, 100, "Perc", False), 40, 56, -6, fin=4.0)
    s.hit(f"{RCF}/Synth Screams Fx 100.wav", 44, -14)
    booms = [f"{RDD}/Cinematic__Big_Drum-13.wav", f"{RDD}/Cinematic__Big_Drum-3.wav",
             f"{RDD}/Cinematic__Big_Drum-10.wav", f"{RDD}/Cinematic__Big_Drum-7.wav"]
    k = 0
    for b in range(8, 60, 4):
        s.hit(booms[k % 4], b, -6 if b < 16 else -4)
        if 24 <= b < 56:
            s.hit(booms[(k + 1) % 4], b + 2, -9)
        k += 1
    s.hit(f"{RCF}/Toms Fx 100.wav", 30, -6)
    s.hit(f"{RCC}/Rev Crash 1.wav", 32, -8, align="peak")
    s.hit(f"{RDH}/Cinematic__Hit-10.wav", 32, -5)
    s.hit(f"{RCF}/Hit 2 100.wav", 56, -6)
    s.master("sw_menu", fade_in=3.0, fade_out=10.0)


def build_music():
    print("music ->", MUSIC)
    song_110()
    song_105()
    song_100()
    song_menu()


def main():
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", default="sfx,voice,music")
    ap.add_argument("--verify", action="store_true", help="speech-recognise the voice lines afterwards")
    a = ap.parse_args()
    parts = a.only.split(",")
    if not SRC.exists():
        sys.exit(f"sample library not found: {SRC} (set SW_SAMPLES)")
    if "sfx" in parts:
        build_sfx()
    if "voice" in parts:
        build_voice(a.verify)
    if "music" in parts:
        build_music()
    print(f"done: {len(REPORT)} files")


if __name__ == "__main__":
    main()
