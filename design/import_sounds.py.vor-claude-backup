# --- audio core ---------------------------------------------------------------------------
def _run(args, data=None):
    r = subprocess.run(args, input=data, capture_output=True)
    if r.returncode != 0:
        raise RuntimeError(f"{args[0]} failed: {r.stderr.decode(errors='replace')[-800:]}")
    return r


def src(rel):
    p = SRC / rel
    if not p.exists():
        raise FileNotFoundError(p)
    return p


_cache = {}


def load(rel, rate=1.0, stereo=False):
    """Decode any file to float64 at 44.1 kHz. rate > 1 plays it faster (pitch up)."""
    key = (rel, rate)
    if key not in _cache:
        af = f"aresample={SR}"
        if abs(rate - 1.0) > 1e-6:
            af += f",asetrate={SR * rate:.3f},aresample={SR}"
        out = _run([FFMPEG, "-v", "error", "-i", str(src(rel)), "-af", af,
                    "-f", "f32le", "-ac", "2", "-ar", str(SR), "-"]).stdout
        _cache[key] = np.frombuffer(out, np.float32).reshape(-1, 2).astype(np.float64)
    a = _cache[key]
    return a.copy() if stereo else a.mean(axis=1)


def ffx(x, filt):
    """Run an array through an ffmpeg audio filter chain."""
    ch = 1 if x.ndim == 1 else x.shape[1]
    out = _run([FFMPEG, "-v", "error", "-f", "f32le", "-ar", str(SR), "-ac", str(ch), "-i", "-",
                "-af", filt, "-f", "f32le", "-ar", str(SR), "-ac", str(ch), "-"],
               x.astype(np.float32).tobytes()).stdout
    y = np.frombuffer(out, np.float32).astype(np.float64)
    return y if ch == 1 else y.reshape(-1, ch)


def hp(x, f, order=2):
    return ffx(x, ",".join([f"highpass=f={f}"] * order))


def lp(x, f, order=2):
    return ffx(x, ",".join([f"lowpass=f={f}"] * order))


def eq(x, f, g, w=1.0):
    return ffx(x, f"equalizer=f={f}:t=q:w={w}:g={g}")


def db(v):
    return 10 ** (v / 20)


def peak(x):
    return float(np.max(np.abs(x))) if len(x) else 0.0


def onset(x, thr_db=-36.0):
    m = np.abs(x) if x.ndim == 1 else np.abs(x).max(axis=1)
    i = np.argmax(m > peak(x) * db(thr_db))
    return max(0, int(i - 0.002 * SR))


def trim(x, thr_db=-36.0):
    return x[onset(x, thr_db):]


def fades(x, fin=0.002, fout=0.05):
    x = x.copy()
    n_in, n_out = min(len(x), int(fin * SR)), min(len(x), int(fout * SR))
    if n_in > 1:
        ramp = np.sin(np.linspace(0, np.pi / 2, n_in)) ** 2
        x[:n_in] *= ramp if x.ndim == 1 else ramp[:, None]
    if n_out > 1:
        ramp = np.cos(np.linspace(0, np.pi / 2, n_out)) ** 2
        x[-n_out:] *= ramp if x.ndim == 1 else ramp[:, None]
    return x


def cut(x, dur, fout=None):
    x = x[:int(dur * SR)]
    return fades(x, 0.002, fout if fout is not None else min(0.35 * len(x) / SR, 0.6))


def decay(x, hold, tau):
    """Keep the first `hold` seconds, then fall off exponentially (shortens long tails)."""
    t = np.arange(len(x)) / SR
    env = np.where(t < hold, 1.0, np.exp(-(t - hold) / tau))
    return x * (env if x.ndim == 1 else env[:, None])


def tailtrim(x, thr_db=-60.0):
    m = np.abs(x) if x.ndim == 1 else np.abs(x).max(axis=1)
    idx = np.nonzero(m > peak(x) * db(thr_db))[0]
    return x[: idx[-1] + 1] if len(idx) else x


def mix(parts, stereo=False):
    """parts: (signal, offset seconds, gain dB)."""
    n = max(int(o * SR) + len(s) for s, o, g in parts)
    out = np.zeros((n, 2) if stereo else n)
    for s, o, g in parts:
        i = int(o * SR)
        out[i:i + len(s)] += s * db(g)
    return out


def norm(x, peak_db):
    p = peak(x)
    return x * (db(peak_db) / p) if p > 0 else x


def to_int16(x):
    tpdf = (RNG.random(x.shape) - RNG.random(x.shape)) / 32768.0
    return np.clip(np.round((x + tpdf) * 32767.0), -32768, 32767).astype("<i2")


def write_wav(path, x):
    path.parent.mkdir(parents=True, exist_ok=True)
    ch = 1 if x.ndim == 1 else x.shape[1]
    with wave.open(str(path), "wb") as w:
        w.setnchannels(ch)
        w.setsampwidth(2)
        w.setframerate(SR)
        w.writeframes(to_int16(x).tobytes())


REPORT = []


def loudness(x):
    """Rough perceived level: max 100 ms RMS after a K-weighting-like pre-filter (dB)."""
    m = x if x.ndim == 1 else x.mean(axis=1)
    k = ffx(m, "highpass=f=60,highshelf=f=1500:g=4")
    c = np.concatenate([[0.0], np.cumsum(k ** 2)])
    w = min(len(k), int(0.1 * SR))
    ms = (c[w:] - c[:-w]) / w
    return 10 * np.log10(ms.max() + 1e-12)


def stats(x):
    m = x if x.ndim == 1 else x.mean(axis=1)
    rms = 20 * np.log10(np.sqrt(np.mean(m ** 2)) + 1e-12)
    seg = m[: min(len(m), SR)]
    sp = np.abs(np.fft.rfft(seg * np.hanning(len(seg))))
    f = np.fft.rfftfreq(len(seg), 1 / SR)
    cen = float((sp * f).sum() / (sp.sum() + 1e-12))
    return len(m) / SR, 20 * np.log10(peak(x) + 1e-12), rms, cen


# Target level per file family (loudness() dB). Battle sounds share one level so the cue
# volumes in audio.lua do the balancing; machinery sits lower, the interface lower still.
LOUD = [("sw_v_ack", -12), ("sw_v_sel", -12), ("sw_v_atk", -12), ("sw_v_", -11),
        ("sw_click", -24), ("sw_select", -25), ("sw_error", -20), ("sw_harvest", -17),
        ("sw_place", -14), ("sw_construct", -14), ("sw_deploy", -13), ("sw_unitout", -14),
        ("sw_unload", -15), ("sw_capture", -13), ("sw_", -9)]


def save(name, x, peak_db=-1.0, sources=(), mono=True, loud=None):
    """Normalise to `loud` (see loudness(); default from LOUD) but never above `peak_db`."""
    if loud is None:
        loud = next(v for k, v in LOUD if name.startswith(k))
    if mono and x.ndim == 2:
        x = x.mean(axis=1)
    x = x - (np.mean(x) if x.ndim == 1 else np.mean(x, axis=0))   # DC
    x = tailtrim(x, -66.0)
    x = fades(x, 0.0015, min(0.02, len(x) / SR / 4))
    x = norm(x, peak_db)
    if loud is not None:
        x = x * min(1.0, db(loud - loudness(x)))
    write_wav(SOUNDS / name, x)
    d, p, r, c = stats(x)
    L = loudness(x)
    REPORT.append((name, d, p, L, c, " + ".join(sources)))
    print(f"  {name:20s} {d:5.2f}s pk {p:5.1f} L {L:6.1f} cen {c:5.0f}  <- {' + '.join(Path(s).name for s in sources)}")


# --- weapon building blocks -------------------------------------------------------------------
def transient(rel, dur, rate=1.0, hold=0.012, tau=0.06, hpf=150, lpf=None, thr=-30.0):
    """The first moments of a recorded shot/blast, pitched and shortened."""
    x = trim(load(rel, rate), thr)
    x = decay(x[: int((dur + 0.1) * SR)], hold, tau)
    x = cut(x, dur, fout=dur * 0.4)
    if hpf:
        x = hp(x, hpf)
    if lpf:
        x = lp(x, lpf)
    return x


def sat(x, drive_db):
    """Soft clipping: denser, louder shots without a higher peak (like a game-audio limiter)."""
    g = db(drive_db)
    x = norm(x, 0)
    return np.tanh(x * g) / np.tanh(g)


def burst(rels_rates, gap, dur, tau):
    parts = []
    for k, (rel, rate) in enumerate(rels_rates):
        parts.append((transient(rel, dur, rate, hold=0.006, tau=tau, hpf=180), k * gap, -k * 0.8))
    return mix(parts)


