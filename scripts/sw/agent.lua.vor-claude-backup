-- STEELWARS -- commanders that think with a language model (Ollama, llm.*).
--
-- Each side an agent plays has a small staff, a chain of command:
--
--   OBERKOMMANDO   reads the whole picture and the reports from below; sets
--                  the posture, the spending, the enemy to go for, and writes
--                  one order to each of the two below it.
--   WIRTSCHAFT     builds: what next, how many harvesters and towers, research.
--   HEER           fights: the army's make-up, what to do, where to strike.
--
-- Every role only sees its own part of the situation and the order from
-- above, and answers into a JSON schema whose choices come from Lua (only what
-- can be built, only the stances the posture allows). It never clicks: the
-- answers become a plan, and the brain of the computer opponent (sw/ai,
-- A.thinkWith) carries it out -- building spots, paths, targets. Its orders go
-- through the session like a player's (N.sendAs), so the simulation stays
-- deterministic. The agent sees through the fog like a player: enemy
-- buildings it has seen, units in sight.
--
-- Without an answer (Ollama off, model missing) the staff works by the book:
-- the brain plays on its own, and the panel says why.
local D = require("sw.defs")
local U = require("sw.util")
local AI = require("sw.ai")

local G = {}
local floor, min, max = math.floor, math.min, math.max

G.staffs = {}           -- slot -> staff
G.list = {}             -- the staffs in slot order
G.show = false          -- the panel
G.model = "qwen3:8b"
G.subModel = ""         -- "" = the same as G.model
G.chiefEvery, G.econEvery, G.armyEvery = 30, 20, 15   -- game seconds
G.attackValue = 3000    -- the army's worth before the chief may order an attack
-- an event wakes a role early, but not sooner than this after its last answer
local EVENT_GAP = { chief = 20, econ = 10, army = 8 }

local ROLE_NAME = { chief = "Oberkommando", econ = "Wirtschaft", army = "Heer" }
local HALTUNG = { "aufbau", "verteidigen", "angriff", "alles_rein" }
local SCHWERPUNKT = { "wirtschaft", "ausgewogen", "heer" }
-- what the army may do under each posture: the chain of command, in Lua
local EINSATZ = {
    aufbau      = { "sammeln", "verteidigen", "ueberfall" },
    verteidigen = { "verteidigen", "sammeln" },
    angriff     = { "angreifen", "ueberfall", "sammeln" },
    alles_rein  = { "alles_rein", "angreifen" },
}
local ZIELE = { "basis", "raffinerie", "harvester", "verteidigung", "naechstes" }
local MIXES = { "ausgewogen", "panzer", "schwer", "infanterie", "flugabwehr", "luft" }

local function pace() return (1 + #G.list) / 2 end
local function has(list, v) for _, x in ipairs(list) do if x == v then return true end end return false end
local function now(S) return (S.tick or 0) * D.TICK end
local function clock(t) return string.format("%d:%02d", floor(t / 60), floor(t % 60)) end
local function nameOf(type) local d = D.units[type] or D.buildings[type]; return d and d.name or type end

-- A model's free text, kept short (whole words, no split umlauts).
local function short(s, n)
    if type(s) ~= "string" then return "" end
    s = s:gsub("%s+", " ")
    if (utf8.len(s) or #s) <= n then return s end
    local out = ""
    for word in s:gmatch("%S+") do
        if (utf8.len(out) or #out) + 1 + (utf8.len(word) or #word) > n then break end
        out = (out == "") and word or (out .. " " .. word)
    end
    return out .. " …"
end

-- --- Setting up -------------------------------------------------------------------------
function G.reset()
    G.staffs, G.list = {}, {}
    if llm then llm.clear() end
end

-- opts: { model, subModel, name }
function G.add(slot, opts)
    opts = opts or {}
    local st = {
        slot = slot, name = opts.name or ("Agent " .. (slot + 1)),
        model = (opts.model and opts.model ~= "") and opts.model or G.model,
        brain = {}, plan = {},
        haltung = "aufbau", schwerpunkt = "ausgewogen", gegner = nil,
        befehl = { econ = "Baue eine Wirtschaft auf.", army = "Sichere die Basis." },
        meldung = { econ = "", army = "" },
        roles = {}, log = {}, events = {},
        seen = {},              -- enemy buildings once seen: id -> { type, x, z, owner }
        seenUnits = {},         -- enemy units in sight now
        lastHarv = nil,         -- where an enemy harvester was last seen
        executeAt = 0, offline = nil, answers = 0, fails = 0,
    }
    local sub = (opts.subModel and opts.subModel ~= "") and opts.subModel or
                ((G.subModel ~= "") and G.subModel or st.model)
    st.roles.chief = { key = "chief", model = st.model, every = G.chiefEvery, nextAt = 1 }
    st.roles.econ = { key = "econ", model = sub, every = G.econEvery, nextAt = 1e9 }
    st.roles.army = { key = "army", model = sub, every = G.armyEvery, nextAt = 1e9 }
    st.ctx = { level = 3, plan = st.plan, rnd = math.random }
    G.staffs[slot] = st
    G.list[#G.list + 1] = st
    table.sort(G.list, function(a, b) return a.slot < b.slot end)
    return st
end

function G.isAgent(slot) return G.staffs[slot] ~= nil end

local function say(st, who, text, S)
    if not text or text == "" then return end
    text = tostring(text):gsub("%s+", " ")
    st.log[#st.log + 1] = { t = now(S), who = who, text = text }
    if #st.log > 40 then table.remove(st.log, 1) end
    if G.onSay then G.onSay(st, who, text) end
end

-- --- What the staff can see -----------------------------------------------------------
local function enemiesOf(S, p)
    local out = {}
    for q = 0, S.nPlayers - 1 do
        if S.enemies(p, q) and S.players[q].alive then out[#out + 1] = q end
    end
    return out
end

local function look(S, st)
    local p = st.slot
    st.seenUnits = {}
    for _, o in ipairs(S.objs) do
        if o.alive and o.owner >= 0 and S.enemies(p, o.owner) then
            if (o.cat == "bld" or (o.cat == "unit" and not o.inside)) and S.sees(p, o.x, o.z) then
                if o.cat == "bld" then
                    st.seen[o.id] = { type = o.type, x = o.x, z = o.z, owner = o.owner }
                else
                    st.seenUnits[#st.seenUnits + 1] = o
                    if o.type == "harvester" then st.lastHarv = { x = o.x, z = o.z, owner = o.owner } end
                end
            end
        end
    end
    -- what is gone is gone (the wreck shows it)
    for id in pairs(st.seen) do
        local o = S.byId[id]
        if not o or not o.alive or not S.enemies(p, o.owner) then st.seen[id] = nil end
    end
end

-- The seen buildings, in id order (no pairs order in anything that matters).
local function seenList(st, owner)
    local ids = {}
    for id, s in pairs(st.seen) do
        if not owner or s.owner == owner then ids[#ids + 1] = id end
    end
    table.sort(ids)
    local out = {}
    for _, id in ipairs(ids) do local s = st.seen[id]; out[#out + 1] = { id = id, type = s.type, x = s.x, z = s.z, owner = s.owner } end
    return out
end

-- Where the army strikes: the HEER's target among what the staff knows.
local function targetFor(st)
    return function(S, p, b)
        local hx, hz = b.homeX or 0, b.homeZ or 0
        local foes = enemiesOf(S, p)
        local want = st.gegner
        if want and not (S.players[want] and S.players[want].alive and S.enemies(p, want)) then want = nil end
        local list = seenList(st, want)
        if #list == 0 and want then list = seenList(st) end
        local kind = st.plan.target or "naechstes"
        local function nearest(filter)
            local best, bd = nil, 1e18
            for _, s in ipairs(list) do
                if s.type ~= "wall" and filter(s) then
                    local d = U.dist2(hx, hz, s.x, s.z)
                    if d < bd then best, bd = s, d end
                end
            end
            return best
        end
        local pick
        if kind == "harvester" and st.lastHarv and (not want or st.lastHarv.owner == want) then
            return st.lastHarv.x, st.lastHarv.z, nil
        end
        if kind == "basis" then pick = nearest(function(s) return s.type == "base" end)
        elseif kind == "raffinerie" or kind == "harvester" then pick = nearest(function(s) return s.type == "refinery" or s.type == "silo" end)
        elseif kind == "verteidigung" then pick = nearest(function(s) return D.buildings[s.type] and D.buildings[s.type].defense end)
        end
        pick = pick or nearest(function() return true end)
        if pick then return pick.x, pick.z, S.get(pick.id) end
        -- nothing seen yet: where they started (the map says where the camps are)
        local q = want or foes[1]
        local best, bd = nil, 1e18
        for _, f in ipairs(want and { want } or foes) do
            local pq = S.players[f]
            if pq.startX then
                local d = U.dist2(hx, hz, pq.startX, pq.startZ)
                if d < bd then best, bd = pq, d end
            end
        end
        if best then return best.startX, best.startZ, nil end
        if q and S.players[q].startX then return S.players[q].startX, S.players[q].startZ, nil end
        return 0, 0, nil
    end
end

-- --- Reports ------------------------------------------------------------------------------
local function counts(S, p)
    local u, b, value, ready = {}, {}, 0, 0
    local bOrder, uOrder = {}, {}
    for _, o in ipairs(S.objs) do
        if o.alive and o.owner == p then
            if o.cat == "bld" and o.type ~= "wall" then
                if not b[o.type] then bOrder[#bOrder + 1] = o.type; b[o.type] = 0 end
                b[o.type] = b[o.type] + 1
            elseif o.cat == "unit" then
                if not u[o.type] then uOrder[#uOrder + 1] = o.type; u[o.type] = 0 end
                u[o.type] = u[o.type] + 1
                if S.weaponOf(o) and not o.def.harvest then
                    value = value + o.def.cost
                    local ord = o.orders[1]
                    if not ord or ord.k == "guard" or ord.k == "move" then ready = ready + 1 end
                end
            end
        end
    end
    return u, b, uOrder, bOrder, value, ready
end

local function listCounts(t, order)
    local parts = {}
    for _, k in ipairs(order) do parts[#parts + 1] = t[k] .. "x " .. nameOf(k) end
    return #parts > 0 and table.concat(parts, ", ") or "nichts"
end

local function economyLine(S, p)
    local pl = S.players[p]
    return string.format("Energiezellen %d, Energicum im Lager %d/%d, Strom %d/%d%s",
        floor(pl.cells), floor(pl.raw), floor(pl.rawCap), floor(pl.power), floor(pl.use),
        pl.lowPower and " (STROMMANGEL)" or "")
end

local function enemyLines(S, st)
    local lines = {}
    local p = st.slot
    for _, q in ipairs(enemiesOf(S, p)) do
        local bl = seenList(st, q)
        local bt, bo = {}, {}
        for _, s in ipairs(bl) do
            if s.type ~= "wall" then
                if not bt[s.type] then bo[#bo + 1] = s.type; bt[s.type] = 0 end
                bt[s.type] = bt[s.type] + 1
            end
        end
        local ut, uo, val = {}, {}, 0
        for _, o in ipairs(st.seenUnits) do
            if o.owner == q then
                if not ut[o.type] then uo[#uo + 1] = o.type; ut[o.type] = 0 end
                ut[o.type] = ut[o.type] + 1
                if not o.def.harvest then val = val + o.def.cost end
            end
        end
        lines[#lines + 1] = string.format("Feind %s: gesehene Gebäude: %s. In Sicht: %s (Kampfwert %d).",
            S.players[q].name, listCounts(bt, bo), listCounts(ut, uo), val)
    end
    return table.concat(lines, "\n")
end

local function threatLine(S, st)
    local b = st.brain
    if not b.homeX then return "Noch keine Basis." end
    local n, val, near = 0, 0, 1e9
    for _, o in ipairs(st.seenUnits) do
        local d = U.dist(o.x, o.z, b.homeX, b.homeZ)
        if d < 160 and not o.def.harvest then n, val = n + 1, val + o.def.cost; near = min(near, d) end
    end
    if n == 0 then return "Keine Feinde nahe der Basis." end
    return string.format("ACHTUNG: %d feindliche Einheiten (Kampfwert %d) %d m vor der Basis!", n, val, floor(near))
end

local function eventLines(st, since)
    local out = {}
    for _, e in ipairs(st.events) do
        if e.t >= since then out[#out + 1] = clock(e.t) .. " " .. e.text end
    end
    while #out > 8 do table.remove(out, 1) end
    return #out > 0 and table.concat(out, "\n") or "keine"
end

