    if #foes == 0 then foes = { "keiner" } end
    local system = "Du bist das OBERKOMMANDO der Armee " .. pl.name .. " im Echtzeit-Strategiespiel STEELWARS. " ..
        "Unter dir stehen zwei Unterkommandanten: WIRTSCHAFT (Gebäude, Harvester, Forschung) und HEER (Truppen, Angriffe). " ..
        "Du klickst nichts selbst: Du beurteilst die Lage, legst Haltung und Schwerpunkt fest und gibst jedem Unterkommandanten " ..
