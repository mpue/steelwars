-- --- The three roles' questions --------------------------------------------------------
-- The postures the chief may choose: no attack without a factory and an army.
local function postures(S, p, value)
    if (S.players[p].has.factory or 0) == 0 or value < G.attackValue then return { "aufbau", "verteidigen" } end
    return HALTUNG
end

-- What an army should be worth by now; below it the money goes to the army.
local function armyDue(S) return min(6000, floor(now(S) / 60) * 1200) end
local function spendings(S, value)
    if now(S) > 180 and value < armyDue(S) then return { "ausgewogen", "heer" } end
    return SCHWERPUNKT
end

