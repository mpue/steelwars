        "Minute 5 mit einem Angriff von 15 bis 25 feindlichen Einheiten: bis dahin muss ein Heer stehen. " ..
        "Antworte auf Deutsch, knapp und militärisch, jeder Text höchstens 15 Wörter, in eigenen Worten.\n" .. RULES
    local prompt = table.concat({
        "LAGEBERICHT, Spielzeit " .. clock(now(S)) .. ". Bisherige Haltung: " .. st.haltung .. ", Schwerpunkt: " .. st.schwerpunkt .. ".",
        "Wirtschaft: " .. economyLine(S, p) .. ".",
        "Eigene Gebäude: " .. listCounts(b, bo) .. ".",
        "Eigene Einheiten: " .. listCounts(u, uo) .. ". Kampfwert " .. value .. ", davon " .. ready .. " Einheiten frei verfügbar.",
        threatLine(S, st),
        enemyLines(S, st),
        string.format("Bilanz: %d zerstört, %d verloren.", pl.stats.killed, pl.stats.lost),
        "Ereignisse: " .. eventLines(st, (st.roles.chief.lastAt or 0) - 1),
        "Mögliche Haltungen jetzt: " .. table.concat(allowed, ", ") ..
            ((#allowed < #HALTUNG) and (" (Angriff erst mit Bot Factory und Kampfwert ab " .. G.attackValue .. ")") or "") .. ".",
        "Mögliche Schwerpunkte jetzt: " .. table.concat(spend, ", ") ..
            ((#spend < #SCHWERPUNKT) and (" (das Heer ist für die Spielzeit zu schwach, Soll " .. armyDue(S) .. ")") or "") .. ".",
        "Meldung WIRTSCHAFT: " .. (st.meldung.econ ~= "" and st.meldung.econ or "(noch keine)"),
        "Meldung HEER: " .. (st.meldung.army ~= "" and st.meldung.army or "(noch keine)"),
    }, "\n")
    local schema = {
        type = "object",
        properties = {
            lage = { type = "string", description = "Deine Lagebeurteilung, höchstens 15 Wörter" },
            haltung = { type = "string", enum = allowed },
            schwerpunkt = { type = "string", enum = spend },
            gegner = { type = "string", enum = foes },
            befehl_wirtschaft = { type = "string" },
            befehl_heer = { type = "string" },
            funkspruch = { type = "string", description = "Ein kurzer Funkspruch an die Truppe, höchstens 12 Wörter" },
        },
        required = { "lage", "haltung", "schwerpunkt", "gegner", "befehl_wirtschaft", "befehl_heer", "funkspruch" },
    }
    return system, prompt, schema
end

-- One of these is enough; a second only costs power.
local SINGLE = { radar = true, lab = true, hangar = true }
local MAX_REFINERIES = 4     -- more only empties the fields faster

-- What the WIRTSCHAFT may choose: buildable now, and not a second radar.
local function buildable(S, p)
    local queued, n = {}, {}     -- in the queue, or standing (built or not)
    for _, o in ipairs(S.objs) do
        if o.alive and o.owner == p and o.cat == "bld" then
            queued[o.type] = true
            n[o.type] = (n[o.type] or 0) + 1
            if o.type == "base" then
                for _, it in ipairs(o.queue) do queued[it.type] = true end
            end
        end
    end
    -- a power plant burns cells: none while the power is plenty
    local pl = S.players[p]
    local surplus = pl.power - pl.use > 150
    local out = {}
    for _, t in ipairs(D.buildingOrder) do
        if t ~= "wall" and S.canProduce(p, t)
            and not (SINGLE[t] and queued[t]) and not (t == "powerplant" and surplus)
            and not (t == "refinery" and (n.refinery or 0) >= MAX_REFINERIES) then out[#out + 1] = t end
    end
    return out
end

local function researchable(S, p)
    local pl = S.players[p]
    local out = {}
    for _, r in ipairs(D.research) do
        if not pl.techs[r.key] and (not r.after or pl.techs[r.after]) and not r.building then out[#out + 1] = r.key end
    end
    for _, k in ipairs({ "refinery_ext", "powerplant_ext", "rocket_tower_ext", "base_armor", "laser_tower_armor" }) do
        if not pl.techs[k] then out[#out + 1] = k end
    end
    return out
end

local function econRequest(S, st)
    local p = st.slot
    local pl = S.players[p]
    local u, b, uo, bo = counts(S, p)
    local can = buildable(S, p)
    local canText = {}
    for _, t in ipairs(can) do canText[#canText + 1] = t .. " (" .. nameOf(t) .. ", " .. D.buildings[t].cost .. ")" end
    local queue = {}
    for _, o in ipairs(S.objs) do
        if o.alive and o.owner == p and o.type == "base" then
            for _, it in ipairs(o.queue) do queue[#queue + 1] = nameOf(it.type) .. (it.done and " (wartet auf Platz)" or "") end
        end
    end
    local lab = nil
    for _, o in ipairs(S.objs) do
        if o.alive and o.owner == p and o.type == "lab" and o.research then lab = o.research.key end
    end
    local res = researchable(S, p)
    local resText = {}
    for _, k in ipairs(res) do resText[#resText + 1] = k .. " (" .. D.researchByKey[k].name .. ")" end
    local system = "Du bist der Unterkommandant WIRTSCHAFT der Armee " .. pl.name .. " in STEELWARS. " ..
        "Du entscheidest, welche Gebäude als Nächstes gebaut werden (bis zu drei, in Reihenfolge), wie viele Harvester " ..
        "und Verteidigungstürme die Basis haben soll und was das Labor erforscht. Kraftwerke bei Strommangel und die erste " ..
        "Raffinerie baut die Basis von selbst. Pro Raffinerie lohnen zwei bis drei Harvester. Führe den Befehl des Oberkommandos aus " ..
        "und melde ihm kurz zurück, was du veranlasst hast. Antworte auf Deutsch, die Meldung höchstens 15 Wörter.\n" .. RULES
    local prompt = table.concat({
        "BEFEHL DES OBERKOMMANDOS: " .. st.befehl.econ,
        "Haltung: " .. st.haltung .. ", Schwerpunkt: " .. st.schwerpunkt .. ". Spielzeit " .. clock(now(S)) .. ".",
        "Wirtschaft: " .. economyLine(S, p) .. ".",
        "Gebäude: " .. listCounts(b, bo) .. ".",
        "Harvester: " .. (u.harvester or 0) .. ". In der Bauschleife: " .. (#queue > 0 and table.concat(queue, ", ") or "nichts") .. ".",
        "Jetzt baubar: " .. table.concat(canText, ", ") .. ".",
        "Labor: " .. ((b.lab or 0) > 0 and (lab and ("forscht " .. lab) or "frei") or "keins") ..
            (#resText > 0 and ((b.lab or 0) > 0 and (". Erforschbar: " .. table.concat(resText, ", ")) or "") or "") .. ".",
        "Ereignisse: " .. eventLines(st, (st.roles.econ.lastAt or 0) - 1),
    }, "\n")
    local resEnum = { "automatisch", "keine" }
    for _, k in ipairs(res) do resEnum[#resEnum + 1] = k end
    if #can == 0 then can = { "powerplant" } end
    local schema = {
        type = "object",
        properties = {
            bauliste = { type = "array", items = { type = "string", enum = can }, maxItems = 3 },
            harvester = { type = "integer", minimum = 1, maximum = 8 },
            tuerme = { type = "integer", minimum = 0, maximum = 8 },
            forschung = { type = "string", enum = resEnum },
            meldung = { type = "string", description = "Meldung an das Oberkommando, höchstens 15 Wörter" },
        },
        required = { "bauliste", "harvester", "tuerme", "forschung", "meldung" },
    }
    return system, prompt, schema
end

local function armyRequest(S, st)
    local p = st.slot
    local pl = S.players[p]
    local u, b, uo, bo, value, ready = counts(S, p)
    local allowed = EINSATZ[st.haltung] or EINSATZ.aufbau
    local system = "Du bist der Unterkommandant HEER der Armee " .. pl.name .. " in STEELWARS. " ..
        "Du bestimmst die Zusammensetzung der Truppe (mix), den Einsatz und das Ziel; Wege und Feuer regeln die Einheiten selbst. " ..
        "Einsatz: sammeln = vor der Basis aufstellen; verteidigen = dicht an der Basis bleiben; angreifen = sobald mindeststaerke " ..
        "Einheiten bereitstehen, alle aufs Ziel; ueberfall = die schnellsten paar Einheiten schlagen zu, der Rest sammelt; " ..
        "alles_rein = jede freie Einheit sofort aufs Ziel. Angegriffene Basis wird immer verteidigt. " ..
        "Mixe: ausgewogen, panzer (viele Tanks), schwer (Eliminator/Terminator), infanterie (Masse), flugabwehr (Rocketeer), luft (Copter/Terminator). " ..
        "Führe den Befehl des Oberkommandos aus und melde ihm kurz zurück. Antworte auf Deutsch, die Meldung höchstens 15 Wörter.\n" .. RULES
    local known = {}
    for _, s in ipairs(seenList(st)) do
        if s.type ~= "wall" and b then
            known[#known + 1] = string.format("%s von %s, %d m entfernt", nameOf(s.type), S.players[s.owner].name,
                floor(U.dist(s.x, s.z, st.brain.homeX or 0, st.brain.homeZ or 0)))
        end
        if #known >= 10 then break end
    end
    local prompt = table.concat({
        "BEFEHL DES OBERKOMMANDOS: " .. st.befehl.army,
        "Haltung: " .. st.haltung .. " (erlaubte Einsätze: " .. table.concat(allowed, ", ") .. "). Spielzeit " .. clock(now(S)) .. ".",
        "Eigene Einheiten: " .. listCounts(u, uo) .. ". Kampfwert " .. value .. ", " .. ready .. " frei verfügbar.",
        "Bisher: Einsatz " .. (st.plan.stance or "-") .. ", Ziel " .. (st.plan.target or "-") .. ", Mix " .. (st.plan.mix or "-") .. ".",
        threatLine(S, st),
        enemyLines(S, st),
        "Bekannte Feindgebäude: " .. (#known > 0 and table.concat(known, "; ") or "noch keine gesehen (Ziel ist dann ihr Startgebiet)") .. ".",
        string.format("Bilanz: %d zerstört, %d verloren.", pl.stats.killed, pl.stats.lost),
        "Ereignisse: " .. eventLines(st, (st.roles.army.lastAt or 0) - 1),
    }, "\n")
    local schema = {
        type = "object",
        properties = {
            einsatz = { type = "string", enum = allowed },
            ziel = { type = "string", enum = ZIELE },
            mix = { type = "string", enum = MIXES },
            mindeststaerke = { type = "integer", minimum = 2, maximum = 40 },
            meldung = { type = "string", description = "Meldung an das Oberkommando, höchstens 15 Wörter" },
        },
        required = { "einsatz", "ziel", "mix", "mindeststaerke", "meldung" },
    }
    return system, prompt, schema
end

-- --- Answers become the plan -------------------------------------------------------------
local function int(v, lo, hi, def)
    v = tonumber(v)
    if not v then return def end
    return U.clamp(floor(v + 0.5), lo, hi)
end

local function applyChief(S, st, d)
    local p = st.slot
    local old = { haltung = st.haltung, schwerpunkt = st.schwerpunkt }
    if has(st.allowedHaltung or HALTUNG, d.haltung) then st.haltung = d.haltung
    elseif not has(st.allowedHaltung or HALTUNG, st.haltung) then st.haltung = "aufbau" end
    if has(st.allowedSpend or SCHWERPUNKT, d.schwerpunkt) then st.schwerpunkt = d.schwerpunkt
    elseif not has(st.allowedSpend or SCHWERPUNKT, st.schwerpunkt) then st.schwerpunkt = "ausgewogen" end
    st.plan.spend = st.schwerpunkt
    st.gegner = nil
    for _, q in ipairs(enemiesOf(S, p)) do
        if S.players[q].name == d.gegner then st.gegner = q end
    end
    if type(d.befehl_wirtschaft) == "string" and d.befehl_wirtschaft ~= "" then st.befehl.econ = short(d.befehl_wirtschaft, 200) end
    if type(d.befehl_heer) == "string" and d.befehl_heer ~= "" then st.befehl.army = short(d.befehl_heer, 200) end
    -- the posture binds the army at once, before the HEER has answered
    if st.plan.stance and not has(EINSATZ[st.haltung], st.plan.stance) then st.plan.stance = EINSATZ[st.haltung][1] end
    say(st, "chief", short(d.lage, 120) .. " -- Haltung " .. st.haltung .. ", Schwerpunkt " .. st.schwerpunkt, S)
    if type(d.funkspruch) == "string" then say(st, "radio", short(d.funkspruch, 100), S) end
    -- the orders go down: at once when the course changed (and the first time), else on their own clock
    local t = now(S)
    local changed = st.haltung ~= old.haltung or st.schwerpunkt ~= old.schwerpunkt or not st.roles.econ.lastAt
    for _, key in ipairs({ "econ", "army" }) do
        local r = st.roles[key]
        if changed then r.nextAt = t elseif r.nextAt > t + r.every * pace() then r.nextAt = t + r.every * pace() end
    end
end

local function applyEcon(S, st, d)
    local can = buildable(S, st.slot)
    local list = {}
    if type(d.bauliste) == "table" then
        for _, t in ipairs(d.bauliste) do
            if has(can, t) and not has(list, t) and #list < 3 then list[#list + 1] = t end
        end
    end
    st.plan.build = list
    -- never fewer than two: a starved economy is the one mistake that ends a game by itself
    st.plan.harvesters = int(d.harvester, 2, 8, st.plan.harvesters)
    st.plan.towers = int(d.tuerme, 0, 8, st.plan.towers)
    if d.forschung == "automatisch" then st.plan.research = nil
    elseif d.forschung == "keine" or D.researchByKey[d.forschung or ""] then st.plan.research = d.forschung end
    st.meldung.econ = short(d.meldung, 140)
    local names = {}
    for _, t in ipairs(list) do names[#names + 1] = nameOf(t) end
    say(st, "econ", st.meldung.econ .. "  [Bau: " .. (#names > 0 and table.concat(names, ", ") or "nichts") ..
        ", " .. (st.plan.harvesters or "?") .. " Harvester, " .. (st.plan.towers or "?") .. " Türme]", S)
end

local function applyArmy(S, st, d)
    local allowed = EINSATZ[st.haltung] or EINSATZ.aufbau
    st.plan.stance = has(allowed, d.einsatz) and d.einsatz or allowed[1]
    if has(ZIELE, d.ziel) then st.plan.target = d.ziel end
    if has(MIXES, d.mix) then st.plan.mix = d.mix end
    st.plan.minUnits = int(d.mindeststaerke, 2, 40, st.plan.minUnits or 6)
    st.meldung.army = short(d.meldung, 140)
    say(st, "army", st.meldung.army .. "  [" .. st.plan.stance .. " -> " .. (st.plan.target or "?") ..
        ", Mix " .. (st.plan.mix or "?") .. ", ab " .. st.plan.minUnits .. "]", S)
end

local REQUEST = { chief = chiefRequest, econ = econRequest, army = armyRequest }
local APPLY = { chief = applyChief, econ = applyEcon, army = applyArmy }

local inflight = {}     -- llm request id -> { staff, role }

local function ask(S, st, role)
    local system, prompt, schema = REQUEST[role.key](S, st)
    local id = llm.chat({
        model = role.model, system = system, prompt = prompt, format = schema,
        options = { temperature = 0.6, num_predict = 300 }, keep_alive = "30m",
    })
    inflight[id] = { st = st, role = role }
    role.busy = id
    role.askedAt = now(S)
    role.lastPrompt = prompt
end

-- --- Events from the simulation (handleEvents passes them on) -----------------------------
function G.event(S, ev)
    if #G.list == 0 then return end
    local t = now(S)
    for _, st in ipairs(G.list) do
        local p = st.slot
        local function note(text, pull)
            st.events[#st.events + 1] = { t = t, text = text }
            if #st.events > 30 then table.remove(st.events, 1) end
            if pull then
                local r = st.roles[pull]
                r.nextAt = min(r.nextAt, max(t, (r.lastAt or -1e9) + EVENT_GAP[pull]))
            end
        end
        if ev.t == "alert" and ev.p == p then
            local near = st.brain.homeX and U.dist(ev.x, ev.z, st.brain.homeX, st.brain.homeZ) < 160
            note(near and "Basis wird angegriffen!" or "Einheiten im Feld unter Beschuss.", "army")
        elseif ev.t == "remove" and ev.how == "killed" and ev.cat ~= "crystal" then
            if ev.owner == p then
                note("Verloren: " .. nameOf(ev.type), ev.cat == "bld" and "chief" or nil)
            elseif ev.owner and ev.owner >= 0 and S.enemies(p, ev.owner) and S.sees(p, ev.x, ev.z) then
                note("Zerstört: feindlicher " .. nameOf(ev.type), nil)
            end
        elseif ev.t == "built" then
            local o = S.byId[ev.id]
            if o and o.owner == p then note("Fertig: " .. nameOf(o.type), "econ") end
        elseif ev.t == "msg" and ev.p == p and ev.sound == "lowpower" then
            note("Strommangel!", "econ")
        elseif ev.t == "defeat" and ev.p ~= p and S.players[ev.p] then
            note(S.players[ev.p].name .. " ist besiegt.", "chief")
        end
    end
end

-- --- Every frame -------------------------------------------------------------------------
-- send(slot, line) puts an order into the session.
function G.update(S, send)
    if #G.list == 0 or not S.tick then return end
    local t = now(S)
    -- answers
    if llm then
        for _, a in ipairs(llm.poll()) do
            local f = inflight[a.id]
            if f then
                inflight[a.id] = nil
                local st, role = f.st, f.role
                role.busy = nil
                role.lastAt = t
                role.ms = a.ms
                if a.ok and type(a.data) == "table" then
                    st.offline = nil
                    st.answers = st.answers + 1
                    local ok, err = pcall(APPLY[role.key], S, st, a.data)
                    if not ok then say(st, "error", "Antwort nicht verwertbar: " .. tostring(err), S) end
                    role.nextAt = t + role.every * pace()
                else
                    st.fails = st.fails + 1
                    st.offline = a.ok and "Antwort war kein JSON" or tostring(a.error or "keine Antwort")
                    say(st, "error", ROLE_NAME[role.key] .. ": " .. st.offline, S)
                    role.nextAt = t + max(role.every * pace(), 20)
                end
            end
        end
    end
    for _, st in ipairs(G.list) do
        local p = st.slot
        local pl = S.players[p]
        if pl and pl.alive and not S.over then
            -- the staff's eyes, and the brain that carries out the plan
            local step = AI.thinkTicks(3)
            local due = floor(S.tick / step)
            if due ~= st.executeAt then
                st.executeAt = due
                look(S, st)
                st.ctx.order = st.ctx.order or function(line) send(p, line) end
                st.ctx.target = st.ctx.target or targetFor(st)
                AI.thinkWith(S, p, st.brain, st.ctx)
            end
            -- the chain of command thinks when it is time
            if llm then
                for _, key in ipairs({ "chief", "army", "econ" }) do
                    local role = st.roles[key]
                    if not role.busy and t >= role.nextAt and (key == "chief" or st.roles.chief.lastAt) then
                        -- one question per role in the queue, and a queue that does not run away
                        if llm.pending() < 2 * #G.list + 1 or key == "chief" then ask(S, st, role) end
                    end
                end
            elseif not st.offline then
                st.offline = "llm.* fehlt (Engine zu alt)"
            end
        end
    end
end

-- --- The panel --------------------------------------------------------------------------
local WHO = {
    chief = { "OK", { 1.0, 0.62, 0.12 } }, econ = { "WI", { 0.45, 0.85, 1.0 } }, army = { "HE", { 1.0, 0.4, 0.3 } },
    radio = { "FUNK", { 0.4, 1.0, 0.5 } }, error = { "!", { 1, 0.3, 0.2 } },
}

-- Cut s to n characters without splitting an umlaut.
local function cut(s, n)
    if utf8.len(s) and utf8.len(s) > n then
        local off = utf8.offset(s, n + 1)
        if off then return s:sub(1, off - 1) .. "…" end
    end
    return s
end

local function wrap(s, n)
    local lines, line = {}, ""
    for word in s:gmatch("%S+") do
        if line == "" then line = word
        elseif (utf8.len(line) or #line) + 1 + (utf8.len(word) or #word) <= n then line = line .. " " .. word
        else lines[#lines + 1] = line; line = word end
    end
    if line ~= "" then lines[#lines + 1] = line end
    return lines
end

function G.draw(S, showSlots)
    if not G.show or #G.list == 0 then return end
    local x, y, w = 14, 58, 560
    for _, st in ipairs(G.list) do
        if not showSlots or showSlots[st.slot] then
            local pl = S.players[st.slot]
            local c = D.teams[pl.color] or D.teams[0]
            local busy = {}
            for _, key in ipairs({ "chief", "econ", "army" }) do
                if st.roles[key].busy then busy[#busy + 1] = ROLE_NAME[key] end
            end
            -- the newest entries that fit whole
            local lines = {}
            for k = #st.log, 1, -1 do
                local l = st.log[k]
                local wr = wrap(l.text, 72)
                if #lines + #wr > 9 then break end
                for j = #wr, 1, -1 do table.insert(lines, 1, { who = l.who, text = wr[j], first = (j == 1), t = l.t }) end
            end
            local h = 66 + #lines * 21
            game.hudRect(x, y, w, h, 0.02, 0.025, 0.03, 0.78, 6)
            game.hudRect(x, y, 6, h, c.r, c.g, c.b, 1, 3)
            game.hudText(x + 16, y + 6, pl.name .. "  ·  " .. st.roles.chief.model, 19, c.r, c.g, c.b, 1, 0, true)
            local status = st.offline and ("ohne Funkverbindung: " .. cut(st.offline, 40)) or
                           (#busy > 0 and ("denkt: " .. table.concat(busy, ", ")) or "bereit")
            game.hudText(x + w - 12, y + 8, status, 15, st.offline and 1 or 0.6, st.offline and 0.35 or 0.65, st.offline and 0.25 or 0.7, 1, 1)
            local P = st.plan
            game.hudText(x + 16, y + 32, string.format("Haltung %s · Schwerpunkt %s · Einsatz %s → %s · Mix %s",
                st.haltung, st.schwerpunkt, P.stance or "-", P.target or "-", P.mix or "-"), 15, 0.75, 0.78, 0.82, 1, 0)
            local yy = y + 56
            for _, l in ipairs(lines) do
                local who = WHO[l.who] or WHO.error
                if l.first then game.hudText(x + 16, yy, who[1], 14, who[2][1], who[2][2], who[2][3], 1, 0, true) end
                game.hudText(x + 62, yy, l.text, 15, 0.88, 0.9, 0.92, 1, 0)
                yy = yy + 21
            end
            y = y + h + 10
        end
    end
end

return G
